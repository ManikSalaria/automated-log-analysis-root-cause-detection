# ==============================================================================
# TRACE Platform — Environment Configuration Template (.env.example)
# Automated Log Analysis and Root Cause Detection System using Machine Learning
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# --- Stage 5: Local LLM Synthesis & Reasoning Runtime ---
# Supported providers: "ollama" (local LLM inference) or "mock" (offline deterministic testing)
TRACE_LLM_PROVIDER=ollama

# Local Ollama daemon endpoint (default port 11434)
TRACE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Recommended default quantized instruct model for CPU inference
# Pull with: ollama pull llama3.2:3b
TRACE_OLLAMA_MODEL=llama3.2:3b

# LLM generation request timeout in seconds (default: 90.0)
# Adjust upward (e.g., 120.0) if running on resource-constrained CPU hardware
TRACE_LLM_TIMEOUT_SEC=90.0

# Maximum retry attempts on transient network or HTTP 500 server errors
TRACE_LLM_MAX_RETRIES=2

# Maximum character limit for evidence context window injected into prompt
TRACE_LLM_MAX_CONTEXT_CHARS=8000

# --- CI/CD Jenkins Integration (Optional) ---
# Used by scripts/verify_jenkins_live_upload.py for live Jenkins log ingestion
# JENKINS_URL=http://localhost:8080
# JENKINS_USER=jenkins_reader
# JENKINS_API_TOKEN=your_jenkins_api_token_here
